```{r, message=FALSE}
# Cargamos las librerías necesarias
library(readr)
library(dplyr)
library(ggplot2)
```

```{r, message=FALSE}
# Importamos los archivos de datos
df_train <- read_csv("train.csv")
df_features <- read_csv("features.csv")
df_stores <- read_csv("stores.csv")
```

```{r}
# Unimos los datos en una sola tabla
df_completo <- left_join(df_train, df_features, by = c("Store", "Date", "IsHoliday"))
df_final <- left_join(df_completo, df_stores, by = "Store")

# Convertimos la columna Date a formato fecha
df_final$Date <- as.Date(df_final$Date)

# Agregamos variables temporales usando funciones básicas de R
df_final$Year <- as.numeric(format(df_final$Date, "%Y"))
df_final$Month <- as.numeric(format(df_final$Date, "%m"))
```

## 1. PREPROCESAMIENTO DE DATOS

### 1.1 Limpieza de datos faltantes

```{r}
# Reemplazar NA en MarkDowns con 0 (no hay promoción)
df_final$MarkDown1[is.na(df_final$MarkDown1)] <- 0
df_final$MarkDown2[is.na(df_final$MarkDown2)] <- 0
df_final$MarkDown3[is.na(df_final$MarkDown3)] <- 0
df_final$MarkDown4[is.na(df_final$MarkDown4)] <- 0
df_final$MarkDown5[is.na(df_final$MarkDown5)] <- 0

# Verificar datos faltantes
cat("Datos faltantes después del tratamiento:", sum(is.na(df_final)))
```

### 1.2 Detección de outliers

```{r}
# Detección simple de outliers con boxplot
boxplot(df_final$Weekly_Sales, main="Outliers en Ventas Semanales")

# Contar outliers usando IQR
Q1 <- quantile(df_final$Weekly_Sales, 0.25, na.rm = TRUE)
Q3 <- quantile(df_final$Weekly_Sales, 0.75, na.rm = TRUE)
IQR <- Q3 - Q1
outliers <- sum(df_final$Weekly_Sales < (Q1 - 1.5*IQR) | df_final$Weekly_Sales > (Q3 + 1.5*IQR))
cat("Número de outliers:", outliers)
```

### 1.3 Transformación de variables

```{r}
# Crear variables útiles
df_final$Total_MarkDown <- df_final$MarkDown1 + df_final$MarkDown2 + 
                          df_final$MarkDown3 + df_final$MarkDown4 + df_final$MarkDown5

df_final$Season <- case_when(
  df_final$Month %in% c(12, 1, 2) ~ "Invierno",
  df_final$Month %in% c(3, 4, 5) ~ "Primavera", 
  df_final$Month %in% c(6, 7, 8) ~ "Verano",
  TRUE ~ "Otoño"
)

cat("Variables creadas: Total_MarkDown, Season")
```

## 2. CONSTRUCCIÓN DE INDICADORES

### 2.1 Indicadores de rendimiento por tienda

```{r}
# Indicadores básicos por tienda
indicadores_tienda <- df_final %>%
  group_by(Store) %>%
  summarise(
    Ventas_Totales = sum(Weekly_Sales, na.rm = TRUE),
    Ventas_Promedio = mean(Weekly_Sales, na.rm = TRUE),
    Tipo_Tienda = first(Type)
  ) %>%
  arrange(desc(Ventas_Totales))

# Top 5 tiendas
print(head(indicadores_tienda, 5))

# Gráfico simple
ggplot(indicadores_tienda, aes(x = reorder(Store, Ventas_Totales), y = Ventas_Totales)) +
  geom_bar(stat = "identity", fill = "steelblue") +
  labs(title = "Ventas Totales por Tienda", x = "Tienda", y = "Ventas") +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))
```

### 2.2 Métricas de estacionalidad

```{r}
# Ventas por estación
estacionalidad <- df_final %>%
  group_by(Season) %>%
  summarise(Ventas_Promedio = mean(Weekly_Sales, na.rm = TRUE))

print(estacionalidad)

# Gráfico de estacionalidad
ggplot(estacionalidad, aes(x = Season, y = Ventas_Promedio, fill = Season)) +
  geom_bar(stat = "identity") +
  labs(title = "Ventas Promedio por Estación", x = "Estación", y = "Ventas") +
  theme(legend.position = "none")
```

### 2.3 Indicadores de impacto de promociones

```{r}
# Comparar ventas con y sin promociones
promociones <- df_final %>%
  mutate(Tiene_Promocion = Total_MarkDown > 0) %>%
  group_by(Tiene_Promocion) %>%
  summarise(Ventas_Promedio = mean(Weekly_Sales, na.rm = TRUE))

print(promociones)

# Calcular incremento
incremento <- (promociones$Ventas_Promedio[2] - promociones$Ventas_Promedio[1]) / 
              promociones$Ventas_Promedio[1] * 100
cat("Incremento con promociones:", round(incremento, 1), "%")
```

### 2.4 KPIs por tipo de tienda

```{r}
# KPIs básicos por tipo
kpis_tipo <- df_final %>%
  group_by(Type) %>%
  summarise(
    Ventas_Promedio = mean(Weekly_Sales, na.rm = TRUE),
    Numero_Tiendas = n_distinct(Store)
  )

print(kpis_tipo)

# Gráfico simple
ggplot(kpis_tipo, aes(x = Type, y = Ventas_Promedio, fill = Type)) +
  geom_bar(stat = "identity") +
  labs(title = "Ventas Promedio por Tipo de Tienda", x = "Tipo", y = "Ventas") +
  theme(legend.position = "none")
```

